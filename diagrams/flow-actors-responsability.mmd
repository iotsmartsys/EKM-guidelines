flowchart TD
    A["Arquiteto<br/>intenção, decisões e ordens"] --> S["Especificação EKOM<br/>fonte normativa"]

    subgraph AUT["1. Autoria da Especificação"]
        S --> D["Redige e confronta autoridades"]
        D --> DC["Draft<br/>commit + push"]
    end

    DC --> AO["Ordem de análise"]

    subgraph ANA["2. Análise de Implementabilidade"]
        AO --> C["Confronta baseline, código,<br/>consumidores e limites"]
        C --> R{"Classificação?"}
        R -- "Não Ready" --> NR["Registra bloqueador<br/>commit + push"]
        R -- "Ready" --> RD["Ready da versão<br/>commit + push"]
    end

    NR --> A
    A --> D
    RD --> IO["Ordem explícita do Arquiteto<br/>para implementar a versão"]

    subgraph IMP["3. Implementação"]
        IO --> IP["Registra In Progress"]
        IP --> I["Implementa + builds"]
        I --> IR["Implemented ou In Progress<br/>relatório + commit + push"]
    end

    IR --> RO["Ordem de revisão"]

    subgraph REV["4. Revisão"]
        RO --> V["Confronta implementação,<br/>contrato e evidências"]
        V --> VD{"Resultado?"}
        VD -- "Defeito técnico" --> I
        VD -- "Defeito normativo" --> D
        VD -- "Aderente" --> RV["Reviewed<br/>relatório + commit + push"]
    end

    RV --> AD{"Decisão do Arquiteto"}
    AD -- "Aceitar" --> DONE["Done / integração autorizada"]
    AD -- "Reabrir" --> D

    S -. "orquestra" .-> AO
    S -.-> IO
    S -.-> RO
